# ============================================================================
#  PostgreSQL
# ============================================================================
# En dev local levanta la BD con:  docker compose up -d postgres
POSTGRES_USER=winlink
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=winlinkhome
# Cadena de conexión. En dev apunta a localhost; en Docker/compose el host es "postgres".
DATABASE_URL=postgres://winlink:cambia-esta-contrasena@localhost:5432/winlinkhome

# ============================================================================
#  Acceso
# ============================================================================
# Password de respaldo (bootstrap). Permite entrar como admin aunque el SSO
# no esté configurado todavía.
APP_PASSWORD=cambia-esta-contrasena
# Secreto para firmar las sesiones — genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Correo con el que se crea/entra el admin de respaldo (login por password)
BOOTSTRAP_ADMIN_EMAIL=admin@parquetempisque.dev
# Correos (separados por coma) que reciben rol admin al provisionarse por SSO
ADMIN_EMAILS=

# ============================================================================
#  Microsoft Entra ID (SSO) — single tenant
# ============================================================================
# Registra la app en https://entra.microsoft.com (App registrations) y pega aquí:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Debe coincidir EXACTO con un Redirect URI (Web) registrado en Entra.
#   prod: https://home.parquetempisque.dev/api/auth/callback
#   dev : http://localhost:5173/api/auth/callback
AZURE_REDIRECT_URI=https://home.parquetempisque.dev/api/auth/callback
# URL pública de la app (para redirigir tras el login)
APP_BASE_URL=https://home.parquetempisque.dev

# ============================================================================
#  Otros
# ============================================================================
# Puerto del servidor API. En prod se usa PORT; en dev API_PORT tiene prioridad
# (evita choques con un PORT inyectado por herramientas).
PORT=3001
# true cuando se sirve detrás de HTTPS (cookies con flag Secure)
COOKIE_SECURE=false
# Carpeta de datos (uploads de fondos). En Docker se monta en un volumen.
DATA_DIR=./data
# Access Key de Unsplash para el selector "Origen de imagen → Unsplash".
# Consíguela creando una app en https://unsplash.com/developers
# Si se deja vacía, esa opción aparece como "no configurada".
UNSPLASH_ACCESS_KEY=
